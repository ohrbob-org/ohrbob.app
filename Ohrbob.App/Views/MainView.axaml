<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ohrbob.App.ViewModels"
             xmlns:views="using:Ohrbob.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Ohrbob.App.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{StaticResource AppBackgroundBrush}"
             Foreground="{StaticResource AppForegroundBrush}">

    <UserControl.Resources>
        <SolidColorBrush x:Key="OhrbobOrange" Color="{StaticResource OhrbobStrongOrange}" />
        <SolidColorBrush x:Key="OhrbobPurple" Color="{StaticResource OhrbobLightBlue}" />
        <SolidColorBrush x:Key="OhrbobDeepNavy" Color="{StaticResource OhrbobPaleYellow}" />
        <SolidColorBrush x:Key="OhrbobDarkNavy" Color="#FFFFFF" />
        <SolidColorBrush x:Key="OhrbobCream" Color="{StaticResource OhrbobDarkBlue}" />
        <SolidColorBrush x:Key="OhrbobWhite" Color="{StaticResource OhrbobDarkBlue}" />
        <SolidColorBrush x:Key="OhrbobGray" Color="#888888" />
        <SolidColorBrush x:Key="OhrbobDarkGray" Color="#e0e0e0" />
        
        <!-- Focused & Hover theme overrides for TextBoxes to prevent white-on-white style issues -->
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource OhrbobPaleYellow}" />
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource OhrbobDarkBlue}" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource OhrbobStrongOrange}" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource OhrbobPaleYellow}" />
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{StaticResource OhrbobDarkBlue}" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="SplitView#MainSplitView">
            <Setter Property="DisplayMode" Value="Inline" />
            <Setter Property="IsPaneOpen" Value="True" />
        </Style>
        <Style Selector="Button#MenuButton">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </UserControl.Styles>

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
        <!-- Onboarding Screen (Displayed when not connected) -->
        <views:OnboardingView IsVisible="{Binding !IsConnected}" />

        <!-- Main App Player Interface (Displayed when connected) -->
        <views:PlayerView IsVisible="{Binding IsConnected}" />
    </Grid>

</UserControl>
