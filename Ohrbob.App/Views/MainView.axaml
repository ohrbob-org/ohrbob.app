<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ohrbob.App.ViewModels"
             xmlns:views="using:Ohrbob.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Ohrbob.App.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource AppBackgroundBrush}"
             Foreground="{DynamicResource AppForegroundBrush}">

    <UserControl.Styles>
        <Style Selector="SplitView#MainSplitView">
            <Setter Property="DisplayMode" Value="Inline" />
            <Setter Property="IsPaneOpen" Value="True" />
        </Style>
        <Style Selector="Button#MenuButton">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </UserControl.Styles>

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Panel>
        <Grid>
            <!-- Onboarding Screen (Displayed when not connected) -->
            <views:OnboardingView IsVisible="{Binding !IsConnected}" />

            <!-- Main App Player Interface (Displayed when connected) -->
            <views:PlayerView IsVisible="{Binding IsConnected}" />
        </Grid>

        <!-- Replace-connection confirmation (shown when a link arrives while connected) -->
        <Border Background="#80000000" IsVisible="{Binding IsReplaceConfirmationVisible}">
            <Border x:Name="ReplaceConfirmationDialog" MaxWidth="360" Margin="16" Padding="24" CornerRadius="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource AppBackgroundBrush}"
                    BoxShadow="0 4 20 0 #40000000">
                <StackPanel Spacing="16">
                    <TextBlock Text="Replace the current connection?"
                               Classes="h2" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource AppForegroundBrush}" />
                    <TextBlock Text="Connecting this link will disconnect the server you are using now."
                               FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource ThemeDarkBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                        <Button x:Name="CancelReplaceButton" Command="{Binding CancelReplaceCommand}" Content="Cancel"
                                MinWidth="110" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                        <Button x:Name="ConfirmReplaceButton" Command="{Binding ConfirmReplaceCommand}" Content="Replace"
                                Classes="btn-primary" MinWidth="110"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Panel>

</UserControl>
