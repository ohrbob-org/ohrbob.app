<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ohrbob.App.ViewModels"
             xmlns:views="using:Ohrbob.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Ohrbob.App.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource AppBackgroundBrush}"
             Foreground="{DynamicResource AppForegroundBrush}">

    <UserControl.Styles>
        <Style Selector="SplitView#MainSplitView">
            <Setter Property="DisplayMode" Value="Inline" />
            <Setter Property="IsPaneOpen" Value="True" />
        </Style>
        <Style Selector="Button#MenuButton">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </UserControl.Styles>

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Panel>
        <Grid>
            <!-- Onboarding Screen (Displayed when not connected) -->
            <views:OnboardingView IsVisible="{Binding !IsConnected}" />

            <!-- Main App Player Interface (Displayed when connected) -->
            <views:PlayerView IsVisible="{Binding IsConnected}" />
        </Grid>

        <!-- Replace-connection confirmation (shown when a link arrives while connected) -->
        <Border Background="#80000000" IsVisible="{Binding IsReplaceConfirmationVisible}">
            <Border x:Name="ReplaceConfirmationDialog" MaxWidth="360" Margin="16" Padding="24" CornerRadius="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource AppBackgroundBrush}"
                    BoxShadow="0 4 20 0 #40000000">
                <StackPanel Spacing="16">
                    <TextBlock Text="Replace the current connection?"
                               Classes="h2" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource AppForegroundBrush}" />
                    <TextBlock Text="Connecting this link will disconnect the server you are using now."
                               FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource ThemeDarkBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                        <Button x:Name="CancelReplaceButton" Command="{Binding CancelReplaceCommand}" Content="Cancel"
                                MinWidth="110" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                        <Button x:Name="ConfirmReplaceButton" Command="{Binding ConfirmReplaceCommand}" Content="Replace"
                                Classes="btn-primary" MinWidth="110"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Per-station settings (opened from the sidebar gear) -->
        <Border Background="#80000000" IsVisible="{Binding IsSettingsOpen}">
            <Border x:Name="SettingsDialog" MaxWidth="420" Margin="16" Padding="24" CornerRadius="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource AppBackgroundBrush}"
                    BoxShadow="0 4 20 0 #40000000">
                <StackPanel Spacing="16">
                    <TextBlock Text="Settings" Classes="h2" />
                    <TextBlock Text="{Binding SelectedStation.Station.Name, FallbackValue='No active station'}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppMutedTextBrush}" />
                    <TextBlock Text="Buffer ahead" FontSize="13" FontWeight="SemiBold" />
                    <ComboBox x:Name="BufferOptionsBox"
                              ItemsSource="{Binding BufferOptions}"
                              SelectedItem="{Binding SelectedBufferOption, Mode=TwoWay}"
                              IsEnabled="{Binding IsBufferSelectionEnabled}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Whole upcoming episodes of this station are downloaded. More buffer uses more storage."
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource AppMutedTextBrush}" />
                    <Border Background="{StaticResource ThemeWarningBrush}" CornerRadius="6" Padding="10"
                            IsVisible="{Binding DownloadBlockedReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding DownloadBlockedReason}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource OhrbobDarkBlue}" />
                    </Border>
                    <Button Content="Close" Command="{Binding CloseSettingsCommand}"
                            Classes="btn-primary" HorizontalAlignment="Right" MinWidth="100" />
                </StackPanel>
            </Border>
        </Border>
    </Panel>

</UserControl>
