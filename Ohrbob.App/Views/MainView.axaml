<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ohrbob.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Ohrbob.App.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{StaticResource OhrbobDarkNavy}"
             Foreground="{StaticResource OhrbobWhite}">

    <UserControl.Resources>
        <SolidColorBrush x:Key="OhrbobOrange" Color="#fc5d00" />
        <SolidColorBrush x:Key="OhrbobPurple" Color="#544ff4" />
        <SolidColorBrush x:Key="OhrbobDeepNavy" Color="#001957" />
        <SolidColorBrush x:Key="OhrbobDarkNavy" Color="#00113B" />
        <SolidColorBrush x:Key="OhrbobCream" Color="#fff4d8" />
        <SolidColorBrush x:Key="OhrbobWhite" Color="#FFFFFF" />
        <SolidColorBrush x:Key="OhrbobGray" Color="#888888" />
        <SolidColorBrush x:Key="OhrbobDarkGray" Color="#333333" />
        
        <!-- Focused & Hover theme overrides for TextBoxes to prevent white-on-white style issues -->
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#00113B" />
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#fc5d00" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#00113B" />
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFF" />
    </UserControl.Resources>

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
        <!-- Onboarding Screen (Displayed when not connected) -->
        <Grid IsVisible="{Binding !IsConnected}" Background="{StaticResource OhrbobDarkNavy}" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="450" Background="{StaticResource OhrbobDeepNavy}" CornerRadius="12" BoxShadow="0 4 20 0 #000000" Padding="30">
                <StackPanel Spacing="15">
                    <!-- Stylized Logo/Title -->
                    <TextBlock Text="ohrbob" FontSize="36" FontWeight="Bold" Foreground="{StaticResource OhrbobOrange}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    
                    <TextBlock Text="Connect Your Ohrbob App" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource OhrbobWhite}" />
                    <TextBlock Text="Scan the QR code in your Ohrbob Web interface or paste the connection deep link below." 
                               FontSize="13" Foreground="{StaticResource OhrbobCream}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15" />

                    <!-- Deep Link Input -->
                    <TextBlock Text="Connection Link (from QR code)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OhrbobCream}" />
                    <TextBox Text="{Binding DeepLinkInput}" PlaceholderText="ohrbob://connect?server=...&amp;token=..." 
                             Background="{StaticResource OhrbobDarkNavy}" BorderBrush="{StaticResource OhrbobDarkGray}" Foreground="{StaticResource OhrbobWhite}" CornerRadius="6" Padding="10,8" />

                    <TextBlock Text="OR Enter Manually" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OhrbobGray}" HorizontalAlignment="Center" Margin="0,5" />

                    <!-- Server URL -->
                    <TextBlock Text="Ohrbob Server URL" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OhrbobCream}" />
                    <TextBox Text="{Binding ServerUrlInput}" PlaceholderText="http://localhost:5002" 
                             Background="{StaticResource OhrbobDarkNavy}" BorderBrush="{StaticResource OhrbobDarkGray}" Foreground="{StaticResource OhrbobWhite}" CornerRadius="6" Padding="10,8" />

                    <!-- Stream Token -->
                    <TextBlock Text="API Stream Token" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OhrbobCream}" />
                    <TextBox Text="{Binding TokenInput}" PlaceholderText="Your profile stream token" 
                             Background="{StaticResource OhrbobDarkNavy}" BorderBrush="{StaticResource OhrbobDarkGray}" Foreground="{StaticResource OhrbobWhite}" CornerRadius="6" Padding="10,8" />

                    <!-- Error Message -->
                    <TextBlock Text="{Binding ConnectionErrorMessage}" Foreground="#FF5555" FontSize="12" TextWrapping="Wrap" 
                               HorizontalAlignment="Center" IsVisible="{Binding ConnectionErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <!-- Connect Button -->
                    <Button Command="{Binding ConnectCommand}" Content="Connect Application" 
                            Background="{StaticResource OhrbobOrange}" Foreground="{StaticResource OhrbobWhite}" FontWeight="Bold" Height="40" CornerRadius="20"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,10,0,0">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="{StaticResource OhrbobPurple}" />
                            </Style>
                        </Button.Styles>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main App Player Interface (Displayed when connected) -->
        <Grid IsVisible="{Binding IsConnected}" ColumnDefinitions="260, *">
            
            <!-- Left Sidebar wrapped in Border for styling -->
            <Border Grid.Column="0" Background="{StaticResource OhrbobDarkNavy}" BorderBrush="{StaticResource OhrbobDarkGray}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto, *, Auto">
                    <!-- App Header -->
                    <StackPanel Grid.Row="0" Margin="24,24,24,15">
                        <TextBlock Text="ohrbob" FontSize="24" FontWeight="Bold" Foreground="{StaticResource OhrbobOrange}" />
                        <TextBlock Text="podcast player" FontSize="11" Foreground="{StaticResource OhrbobGray}" FontWeight="SemiBold" LetterSpacing="1" />
                    </StackPanel>

                    <!-- Stations List Section -->
                    <Grid Grid.Row="1" RowDefinitions="Auto, *">
                        <TextBlock Grid.Row="0" Text="YOUR STATIONS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OhrbobCream}" Margin="24,15,24,8" />
                        
                        <ListBox Grid.Row="1" ItemsSource="{Binding Stations}" SelectedItem="{Binding SelectedStation}"
                                 Background="Transparent" BorderThickness="0" Margin="12,0,12,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto, *" Margin="8,4">
                                        <PathIcon Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8Z" 
                                                  Width="16" Height="16" Foreground="{StaticResource OhrbobOrange}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource OhrbobWhite}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="4,8" />
                                    <Setter Property="CornerRadius" Value="6" />
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{StaticResource OhrbobDeepNavy}" />
                                </Style>
                            </ListBox.Styles>
                        </ListBox>
                    </Grid>

                    <!-- Sidebar Footer (Settings / Disconnect) -->
                    <Border Grid.Row="2" Background="{StaticResource OhrbobDarkNavy}" Padding="16" BorderBrush="{StaticResource OhrbobDarkGray}" BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Connected Stream" FontSize="11" Foreground="{StaticResource OhrbobGray}" FontWeight="SemiBold" />
                                <TextBlock Text="Active Profile" FontSize="13" Foreground="{StaticResource OhrbobWhite}" FontWeight="SemiBold" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding DisconnectCommand}" Content="Disconnect"
                                    Background="{StaticResource OhrbobDarkGray}" Foreground="{StaticResource OhrbobWhite}" FontSize="11" CornerRadius="12" Padding="12,6" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Detail Player View wrapped in Border for padding & styling -->
            <Border Grid.Column="1" Background="{StaticResource OhrbobDeepNavy}" Padding="32">
                <Grid RowDefinitions="*, Auto">
                    
                    <!-- Center Info Pane (Episode details, Cover Art, Description) -->
                    <Grid Grid.Row="0" ColumnDefinitions="320, *" Margin="0,0,0,24">
                        <!-- Album Art Block -->
                        <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="280" Height="280" Background="{StaticResource OhrbobDarkNavy}" CornerRadius="16" BoxShadow="0 8 30 0 #000000">
                                <!-- Placeholder or Image -->
                                <Panel>
                                    <PathIcon Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,10A2,2 0 0,0 10,12A2,2 0 0,0 12,14A2,2 0 0,0 14,12A2,2 0 0,0 12,10Z" 
                                              Width="64" Height="64" Foreground="{StaticResource OhrbobOrange}" Opacity="0.5" />
                                    <Image Source="{Binding CurrentEpisodeCoverUrl}" Stretch="UniformToFill" Margin="0" IsVisible="{Binding CurrentEpisodeCoverUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    
                                    <!-- Buffering Blur Overlay -->
                                    <Border Background="#CC00113B" CornerRadius="16" IsVisible="{Binding IsBuffering}">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                                            <ProgressBar IsIndeterminate="True" Width="100" Height="4" Foreground="{StaticResource OhrbobOrange}" Background="Transparent" />
                                            <TextBlock Text="Buffering..." FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OhrbobWhite}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Panel>
                            </Border>
                        </Grid>

                        <!-- Text Details Box -->
                        <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto" Margin="24,12,0,12">
                            <!-- Station & Episode Title -->
                            <StackPanel Grid.Row="0" Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding SelectedStation.Name, FallbackValue='No Active Station'}" 
                                               FontSize="12" FontWeight="Bold" Foreground="{StaticResource OhrbobOrange}" LetterSpacing="1" />
                                    <Border Background="{StaticResource OhrbobOrange}" CornerRadius="4" Padding="6,2" IsVisible="{Binding IsBuffering}">
                                        <TextBlock Text="Buffering..." FontSize="9" FontWeight="Bold" Foreground="{StaticResource OhrbobWhite}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding CurrentEpisodeTitle}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource OhrbobWhite}" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Episode Description Scrollable Panel -->
                            <ScrollViewer Grid.Row="1" Margin="0,16,0,16" VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding CurrentEpisodeDescription}" FontSize="14" Foreground="{StaticResource OhrbobCream}" TextWrapping="Wrap" LineHeight="20" />
                            </ScrollViewer>

                            <!-- Up Next Feature -->
                            <Border Grid.Row="2" Background="{StaticResource OhrbobDarkNavy}" CornerRadius="8" Padding="12,10" IsVisible="{Binding NextEpisodeTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="NEXT:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OhrbobOrange}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding NextEpisodeTitle}" FontSize="12" Foreground="{StaticResource OhrbobWhite}" FontWeight="SemiBold" MaxWidth="300" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Bottom Controller Deck (Seekbar, Controls, Action buttons) -->
                    <Grid Grid.Row="1" RowDefinitions="Auto, Auto" Margin="0,0,0,12">
                        <!-- Progress Slider Panel -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,16">
                            <TextBlock Grid.Column="0" Text="{Binding PositionText}" FontSize="12" Foreground="{StaticResource OhrbobCream}" Width="40" TextAlignment="Left" />
                            <Slider Grid.Column="1" Value="{Binding PositionSeconds}" Maximum="{Binding DurationSeconds}" Margin="12,0" Height="20" />
                            <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="12" Foreground="{StaticResource OhrbobCream}" Width="40" TextAlignment="Right" />
                        </Grid>

                        <!-- Control Buttons Pane -->
                        <Grid Grid.Row="1" ColumnDefinitions="*, Auto, *">
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="24">
                                <!-- Skip Back 15s -->
                                <Button Command="{Binding SeekBackCommand}" Width="40" Height="40" CornerRadius="20" Background="{StaticResource OhrbobDarkNavy}">
                                    <PathIcon Data="M12.5,3C17.15,3 21.08,6.03 22.47,10.15L20.1,10.94C19.07,7.85 16.03,5.5 12.5,5.5C8.36,5.5 5,8.86 5,13C5,17.14 8.36,20.5 12.5,20.5C16.15,20.5 19.21,17.9 20.17,14.5H22.72C21.72,19.3 17.5,23 12.5,23C7,23 2.5,18.5 2.5,13C2.5,7.5 7,3 12.5,3M12.5,8V13H17.5V14.5H11V8H12.5Z" 
                                              Width="18" Height="16" Foreground="{StaticResource OhrbobWhite}" />
                                </Button>

                                <!-- Play / Pause Circular Toggle -->
                                <Button Command="{Binding TogglePlayCommand}" Width="56" Height="56" CornerRadius="28" Background="{StaticResource OhrbobOrange}">
                                    <Panel>
                                        <PathIcon Data="M8,5.14V19.14L19,12.14L8,5.14Z" Width="24" Height="24" Foreground="{StaticResource OhrbobWhite}" IsVisible="{Binding !IsPlaying}" />
                                        <PathIcon Data="M14,19H18V5H14M6,19H10V5H6V19Z" Width="20" Height="20" Foreground="{StaticResource OhrbobWhite}" IsVisible="{Binding IsPlaying}" />
                                    </Panel>
                                </Button>

                                <!-- Skip Forward 30s -->
                                <Button Command="{Binding SeekForwardCommand}" Width="40" Height="40" CornerRadius="20" Background="{StaticResource OhrbobDarkNavy}">
                                    <PathIcon Data="M11.5,3C17,3 21.5,7.5 21.5,13C21.5,18.5 17,23 11.5,23C6.5,23 2.28,19.3 1.28,14.5H3.83C4.79,17.9 7.85,20.5 11.5,20.5C15.64,20.5 19,17.14 19,13C19,8.86 15.64,5.5 11.5,5.5C7.97,5.5 4.93,7.85 3.9,10.94L1.53,10.15C2.92,6.03 6.85,3 11.5,3M14,8V14.5H7.5V13H12.5V8H14Z" 
                                              Width="18" Height="16" Foreground="{StaticResource OhrbobWhite}" />
                                </Button>

                                <!-- Next Track -->
                                <Button Command="{Binding SkipToNextCommand}" Width="40" Height="40" CornerRadius="20" Background="{StaticResource OhrbobDarkNavy}">
                                    <PathIcon Data="M6,18L14.5,12L6,6V18M16,6V18H18V6H16Z" Width="16" Height="16" Foreground="{StaticResource OhrbobWhite}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    
                </Grid>
            </Border>
            
        </Grid>
    </Grid>

</UserControl>
