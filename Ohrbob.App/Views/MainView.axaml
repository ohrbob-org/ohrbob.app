<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ohrbob.App.ViewModels"
             xmlns:views="using:Ohrbob.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Ohrbob.App.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource AppBackgroundBrush}"
             Foreground="{DynamicResource AppForegroundBrush}">

    <UserControl.Styles>
        <Style Selector="SplitView#MainSplitView">
            <Setter Property="DisplayMode" Value="Inline" />
            <Setter Property="IsPaneOpen" Value="True" />
        </Style>
        <Style Selector="Button#MenuButton">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </UserControl.Styles>

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
        <!-- Onboarding Screen (Displayed when not connected) -->
        <views:OnboardingView IsVisible="{Binding !IsConnected}" />

        <!-- Main App Player Interface (Displayed when connected) -->
        <views:PlayerView IsVisible="{Binding IsConnected}" />
    </Grid>

</UserControl>
