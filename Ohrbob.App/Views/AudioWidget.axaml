<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ohrbob.App.ViewModels"
             xmlns:services="using:Ohrbob.App.Services"
             xmlns:views="using:Ohrbob.App.Views"
             x:Class="Ohrbob.App.Views.AudioWidget"
             x:DataType="vm:MainViewModel">

    <UserControl.Resources>
        <SolidColorBrush x:Key="GlassBarBackground" Color="#E9E8FD" />
        <SolidColorBrush x:Key="GlassBarBorder" Color="#66FFFFFF" />
        <SolidColorBrush x:Key="GlassControlBackground" Color="#14001957" />
        <SolidColorBrush x:Key="GlassPrimaryBackground" Color="#26FC5D00" />
        <SolidColorBrush x:Key="GlassInactiveTrack" Color="#1F001957" />
        <SolidColorBrush x:Key="GlassIconForeground" Color="#80001957" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Thin range tracks, matching the Bootstrap audio-range mixin. -->
        <Style Selector="Slider.audio-range">
            <Setter Property="Height" Value="16" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Slider.audio-range /template/ Track">
            <Setter Property="Height" Value="4" />
        </Style>
        <Style Selector="Slider.audio-range /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Background" Value="{StaticResource GlassInactiveTrack}" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>
        <Style Selector="Slider.progress /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Background" Value="#544FF4" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>
        <Style Selector="Slider.volume /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Background" Value="#FC5D00" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>
        <Style Selector="Slider.audio-range /template/ Thumb#thumb">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#33001957" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Bootstrap media query: below 768px switch to the compact bar. -->
        <Style Selector="Grid#MobileBar">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <ContainerQuery Name="audioWidget" Query="max-width: 767">
            <Style Selector="Grid#DesktopBar">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="Grid#MobileBar">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <!-- The frosted layer is a live blur over a VisualBrush of the page.
                 It is re-rendered every frame, which makes animations stutter on
                 phones, so mobile keeps the flat translucent veil instead. -->
            <Style Selector="Border#FrostClip">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </ContainerQuery>
    </UserControl.Styles>

    <Border Name="RootBorder"
            Container.Name="audioWidget"
            Container.Sizing="Width"
            Background="{StaticResource GlassBarBackground}"
            BorderBrush="{StaticResource GlassBarBorder}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="0"
            Margin="16"
            BoxShadow="0 8 32 0 #1A001957">
        <Panel>
            <!-- Frosted layer: Avalonia has no backdrop-filter, so we paint the
                 scroll content behind the bar and clip it to the bar's rounded
                 corners. The source-sized layer sits bottom-left so the brush
                 shows the slice that is actually behind the floating bar. -->
            <Border Name="FrostClip" CornerRadius="15" ClipToBounds="True" IsHitTestVisible="False">
                <Canvas ClipToBounds="True">
                    <Border Name="FrostLayer" Canvas.Left="0" Canvas.Bottom="0"
                            Width="{Binding $parent[views:AudioWidget].BackdropSource.Bounds.Width}"
                            Height="{Binding $parent[views:AudioWidget].BackdropSource.Bounds.Height}">
                        <Border.Effect>
                            <BlurEffect Radius="12" />
                        </Border.Effect>
                        <Border.Background>
                            <VisualBrush Visual="{Binding $parent[views:AudioWidget].BackdropSource}" Stretch="None" />
                        </Border.Background>
                    </Border>
                </Canvas>
            </Border>

            <!-- Lavender veil keeps the Bootstrap glass colour over the blur. -->
            <Border CornerRadius="15" Background="#73E9E8FD" IsHitTestVisible="False" />

            <Panel Margin="16,10">
            <!-- Desktop / landscape bar -->
            <Grid Name="DesktopBar" ColumnDefinitions="*,Auto,2*,Auto,Auto" ColumnSpacing="16">
                <!-- Meta: cover art only -->
                <Grid Grid.Column="0" ColumnDefinitions="Auto" VerticalAlignment="Center">
                    <Border Name="CoverBorder" Grid.Column="0" Width="56" Height="56" CornerRadius="8"
                            ClipToBounds="True" Background="{DynamicResource AppSurfaceBrush}" VerticalAlignment="Center">
                        <Panel>
                            <PathIcon Data="M12,3V13.55C11.41,13.21 10.73,13 10,13A3,3 0 0,0 7,16A3,3 0 0,0 10,19A3,3 0 0,0 13,16V7H17V3H12Z"
                                      Width="24" Height="24" Foreground="{StaticResource ThemeDarkBrush}" Opacity="0.3"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image services:ImageLoader.Source="{Binding CurrentEpisodeCoverUrl}" Stretch="UniformToFill"
                                   IsVisible="{Binding CurrentEpisodeCoverUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </Panel>
                    </Border>
                </Grid>

                <!-- Transport -->
                <StackPanel Name="ControlsPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <Button Name="BackButton" Command="{Binding SkipToPreviousCommand}"
                            Width="32" Height="32" CornerRadius="16" Padding="0"
                            Background="{StaticResource GlassControlBackground}" BorderBrush="{StaticResource GlassBarBorder}"
                            BorderThickness="1"
                            ToolTip.Tip="Previous episode">
                        <PathIcon Data="M11,19 L2,12 L11,5 Z M22,19 L13,12 L22,5 Z" Width="16" Height="16"
                                  Foreground="{StaticResource GlassIconForeground}" />
                    </Button>

                    <Button Name="SkipBackButton" Command="{Binding SeekBackCommand}" Width="34" Height="34" CornerRadius="17" Padding="0"
                            Background="{StaticResource GlassControlBackground}" BorderBrush="{StaticResource GlassBarBorder}"
                            BorderThickness="1"
                            ToolTip.Tip="Skip back 15 seconds">
                        <PathIcon Data="M12.5,3C17.15,3 21.08,6.03 22.47,10.15L20.1,10.94C19.07,7.85 16.03,5.5 12.5,5.5C8.36,5.5 5,8.86 5,13C5,17.14 8.36,20.5 12.5,20.5C16.15,20.5 19.21,17.9 20.17,14.5H22.72C21.72,19.3 17.5,23 12.5,23C7,23 2.5,18.5 2.5,13C2.5,7.5 7,3 12.5,3M12.5,8V13H17.5V14.5H11V8H12.5Z"
                                  Width="20" Height="20" Foreground="{StaticResource GlassIconForeground}" />
                    </Button>

                    <Border CornerRadius="25" Background="{StaticResource GlassPrimaryBackground}"
                            BorderBrush="{StaticResource GlassBarBorder}" BorderThickness="1"
                            BoxShadow="0 4 8 0 #33FC5D00">
                        <Button Name="PlayButton" Command="{Binding TogglePlayCommand}" Width="48" Height="48" CornerRadius="24" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                ToolTip.Tip="Play / pause">
                            <Panel>
                                <PathIcon Data="M7,4 L19,12 L7,20 Z" Margin="2,0,0,0" Width="20" Height="20"
                                          Foreground="{StaticResource OhrbobStrongOrange}" IsVisible="{Binding !IsPlaying}" />
                                <PathIcon Data="M6,4 H10 V20 H6 Z M14,4 H18 V20 H14 Z" Width="20" Height="20"
                                          Foreground="{StaticResource OhrbobStrongOrange}" IsVisible="{Binding IsPlaying}" />
                            </Panel>
                        </Button>
                    </Border>

                    <Button Name="SkipForwardButton" Command="{Binding SeekForwardCommand}" Width="34" Height="34" CornerRadius="17" Padding="0"
                            Background="{StaticResource GlassControlBackground}" BorderBrush="{StaticResource GlassBarBorder}"
                            BorderThickness="1"
                            ToolTip.Tip="Skip forward 30 seconds">
                        <PathIcon Data="M11.5,3C17,3 21.5,7.5 21.5,13C21.5,18.5 17,23 11.5,23C6.5,23 2.28,19.3 1.28,14.5H3.83C4.79,17.9 7.85,20.5 11.5,20.5C15.64,20.5 19,17.14 19,13C19,8.86 15.64,5.5 11.5,5.5C7.97,5.5 4.93,7.85 3.9,10.94L1.53,10.15C2.92,6.03 6.85,3 11.5,3M14,8V14.5H7.5V13H12.5V8H14Z"
                                  Width="20" Height="20" Foreground="{StaticResource GlassIconForeground}" />
                    </Button>

                    <Button Name="ForwardButton" Command="{Binding SkipToNextCommand}" Width="32" Height="32" CornerRadius="16" Padding="0"
                            Background="{StaticResource GlassControlBackground}" BorderBrush="{StaticResource GlassBarBorder}"
                            BorderThickness="1"
                            ToolTip.Tip="Next episode">
                        <PathIcon Data="M13,19 L22,12 L13,5 Z M2,19 L11,12 L2,5 Z" Width="16" Height="16"
                                  Foreground="{StaticResource GlassIconForeground}" />
                    </Button>
                </StackPanel>

                <!-- Seek bar -->
                <Grid Name="ProgressGroup" Grid.Column="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"
                      VerticalAlignment="Center" MinWidth="120">
                    <TextBlock Grid.Column="0" Text="{Binding PositionText}" FontSize="12" Width="38" TextAlignment="Right"
                               VerticalAlignment="Center" Opacity="0.7" Foreground="{DynamicResource ThemeDarkBrush}" />
                    <Slider Name="ProgressSlider" Grid.Column="1" Classes="audio-range progress"
                            Minimum="0" Maximum="{Binding SeekMaximum}" Value="{Binding PositionSeconds}"
                            VerticalAlignment="Center">
                    </Slider>
                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="12" Width="38"
                               VerticalAlignment="Center" Opacity="0.7" Foreground="{DynamicResource ThemeDarkBrush}" />
                </Grid>

                <!-- Volume -->
                <StackPanel Name="VolumeGroup" Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Width="28" Height="28" CornerRadius="14" Padding="0" Background="Transparent"
                            BorderThickness="0" Opacity="0.6" ToolTip.Tip="Volume">
                        <PathIcon Data="M14,3.23V5.29C16.89,6.15 19,8.83 19,12C19,15.17 16.89,17.85 14,18.71V20.77C18,19.86 21,16.28 21,12C21,7.72 18,4.14 14,3.23M16.5,12C16.5,10.23 15.5,8.71 14,7.97V16C15.5,15.29 16.5,13.77 16.5,12M3,9V15H7L12,20V4L7,9H3Z"
                                  Width="16" Height="16" Foreground="{DynamicResource ThemeDarkBrush}" />
                    </Button>
                    <Slider Name="VolumeSlider" Classes="audio-range volume" Width="90"
                            Minimum="0" Maximum="100" Value="{Binding Volume}" VerticalAlignment="Center">
                    </Slider>
                </StackPanel>

                <!-- Station settings -->
                <Button Name="SettingsButton" Grid.Column="4" Command="{Binding OpenStationSettingsCommand}"
                        Width="28" Height="28" CornerRadius="14" Padding="0" Background="Transparent"
                        BorderThickness="0" Opacity="0.6" ToolTip.Tip="Station Settings">
                    <PathIcon Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12C19.5,11.66 19.47,11.34 19.43,11.02L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.65 15.48,5.32 14.87,5.07L14.49,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.51,2.42L9.13,5.07C8.52,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11.02C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.52,18.68 9.13,18.93L9.51,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.49,21.58L14.87,18.93C15.48,18.68 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.98Z"
                              Width="16" Height="16" Foreground="{DynamicResource ThemeDarkBrush}" />
                </Button>
            </Grid>

            <!-- Mobile / portrait bar (Bootstrap <768px) -->
            <Grid Name="MobileBar" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Grid Grid.Column="0" ColumnDefinitions="Auto" VerticalAlignment="Center">
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8"
                            ClipToBounds="True" Background="{DynamicResource AppSurfaceBrush}" VerticalAlignment="Center">
                        <Panel>
                            <PathIcon Data="M12,3V13.55C11.41,13.21 10.73,13 10,13A3,3 0 0,0 7,16A3,3 0 0,0 10,19A3,3 0 0,0 13,16V7H17V3H12Z"
                                      Width="20" Height="20" Foreground="{StaticResource ThemeDarkBrush}" Opacity="0.3"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image services:ImageLoader.Source="{Binding CurrentEpisodeCoverUrl}" Stretch="UniformToFill"
                                   IsVisible="{Binding CurrentEpisodeCoverUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </Panel>
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <Button Command="{Binding SeekBackCommand}" Width="34" Height="34" CornerRadius="17" Padding="0"
                            Background="{StaticResource GlassControlBackground}" BorderBrush="{StaticResource GlassBarBorder}"
                            BorderThickness="1"
                            ToolTip.Tip="Skip back 15 seconds">
                        <PathIcon Data="M12.5,3C17.15,3 21.08,6.03 22.47,10.15L20.1,10.94C19.07,7.85 16.03,5.5 12.5,5.5C8.36,5.5 5,8.86 5,13C5,17.14 8.36,20.5 12.5,20.5C16.15,20.5 19.21,17.9 20.17,14.5H22.72C21.72,19.3 17.5,23 12.5,23C7,23 2.5,18.5 2.5,13C2.5,7.5 7,3 12.5,3M12.5,8V13H17.5V14.5H11V8H12.5Z"
                                  Width="20" Height="20" Foreground="{StaticResource GlassIconForeground}" />
                    </Button>

                    <Border CornerRadius="23" Background="{StaticResource GlassPrimaryBackground}"
                            BorderBrush="{StaticResource GlassBarBorder}" BorderThickness="1"
                            BoxShadow="0 4 8 0 #33FC5D00">
                        <Button Name="MobilePlayButton" Command="{Binding TogglePlayCommand}" Width="44" Height="44" CornerRadius="22" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                ToolTip.Tip="Play / pause">
                            <Panel>
                                <PathIcon Data="M7,4 L19,12 L7,20 Z" Margin="2,0,0,0" Width="20" Height="20"
                                          Foreground="{StaticResource OhrbobStrongOrange}" IsVisible="{Binding !IsPlaying}" />
                                <PathIcon Data="M6,4 H10 V20 H6 Z M14,4 H18 V20 H14 Z" Width="20" Height="20"
                                          Foreground="{StaticResource OhrbobStrongOrange}" IsVisible="{Binding IsPlaying}" />
                            </Panel>
                        </Button>
                    </Border>

                    <Button Command="{Binding SeekForwardCommand}" Width="34" Height="34" CornerRadius="17" Padding="0"
                            Background="{StaticResource GlassControlBackground}" BorderBrush="{StaticResource GlassBarBorder}"
                            BorderThickness="1"
                            ToolTip.Tip="Skip forward 30 seconds">
                        <PathIcon Data="M11.5,3C17,3 21.5,7.5 21.5,13C21.5,18.5 17,23 11.5,23C6.5,23 2.28,19.3 1.28,14.5H3.83C4.79,17.9 7.85,20.5 11.5,20.5C15.64,20.5 19,17.14 19,13C19,8.86 15.64,5.5 11.5,5.5C7.97,5.5 4.93,7.85 3.9,10.94L1.53,10.15C2.92,6.03 6.85,3 11.5,3M14,8V14.5H7.5V13H12.5V8H14Z"
                                  Width="20" Height="20" Foreground="{StaticResource GlassIconForeground}" />
                    </Button>
                </StackPanel>
            </Grid>
            </Panel>
        </Panel>
    </Border>
</UserControl>
