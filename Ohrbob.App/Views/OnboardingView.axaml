<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ohrbob.App.ViewModels"
             xmlns:views="using:Ohrbob.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
             x:Class="Ohrbob.App.Views.OnboardingView"
             x:DataType="vm:MainViewModel"
             Container.Name="onboarding"
             Container.Sizing="Width">

    <UserControl.Styles>
        <Style Selector="TextBlock.onboardingFieldLabel">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="2" />
            <Setter Property="Foreground" Value="#99FFFFFF" />
        </Style>
        <Style Selector="TextBox.onboardingField">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#40FFFFFF" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="10,10" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <ContainerQuery Name="onboarding" Query="max-width: 880">
            <Style Selector="Border#ConnectPanel">
                <Setter Property="Margin" Value="24,10,24,24" />
                <Setter Property="MaxWidth" Value="560" />
            </Style>
            <Style Selector="TextBlock#OnboardingWordmark">
                <Setter Property="FontSize" Value="58" />
            </Style>
            <Style Selector="Grid#OnboardingHeader">
                <Setter Property="Margin" Value="24,20,24,0" />
            </Style>
        </ContainerQuery>
    </UserControl.Styles>

    <!-- Immersive Metro start screen. The block pattern is drawn in XAML so it
         stays crisp at every density and follows the brand palette. -->
    <Grid Background="{StaticResource MetroNavyBrush}" ClipToBounds="True">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="#00133F" />
                <GradientStop Offset="0.6" Color="#001957" />
                <GradientStop Offset="1" Color="#080B12" />
            </LinearGradientBrush>
        </Grid.Background>

        <Canvas IsHitTestVisible="False" Opacity="0.92">
            <Border Canvas.Left="-40" Canvas.Top="120" Width="260" Height="260"
                    Background="{StaticResource MetroVioletBrush}" Opacity="0.16" />
            <Border Canvas.Right="40" Canvas.Top="-50" Width="320" Height="320"
                    Background="{StaticResource MetroYellowBrush}" Opacity="0.07" />
            <Border Canvas.Right="220" Canvas.Bottom="-70" Width="240" Height="240"
                    Background="{StaticResource MetroVioletBrush}" Opacity="0.12" />
        </Canvas>

        <Grid RowDefinitions="Auto,*,Auto" Margin="0">
            <Grid x:Name="OnboardingHeader" Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="46,34,42,0">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="38" Height="38" Background="{StaticResource MetroAccentBrush}">
                        <TextBlock Text="o" FontFamily="{StaticResource SulphurPoint}" FontWeight="Bold"
                                   FontSize="26" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="ohrbob" FontFamily="{StaticResource SulphurPoint}" FontWeight="Bold"
                                   FontSize="20" Foreground="White" />
                        <TextBlock Text="private podcast player" FontSize="9" FontWeight="SemiBold"
                                   LetterSpacing="2" Foreground="#80FFFFFF" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="CONNECT" Classes="metroLabel"
                           Foreground="#80FFFFFF" VerticalAlignment="Center" />
            </Grid>

            <Grid x:Name="OnboardingBody" Grid.Row="1" ColumnDefinitions="*,470" Margin="46,0,46,0">
                <StackPanel x:Name="OnboardingHero" Grid.Column="0" VerticalAlignment="Center"
                            Spacing="18" Margin="0,0,40,0" MaxWidth="700">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="42" Height="8" Background="{StaticResource MetroAccentBrush}" />
                        <Border Width="18" Height="8" Background="{StaticResource MetroVioletBrush}" />
                        <Border Width="10" Height="8" Background="{StaticResource MetroYellowBrush}" />
                    </StackPanel>
                    <TextBlock Text="your stations." FontSize="13" FontWeight="Bold" LetterSpacing="3"
                               Foreground="{StaticResource MetroAccentSoftBrush}" />
                    <TextBlock x:Name="OnboardingWordmark" Text="ohrbob" Classes="metroDisplay"
                               FontSize="118" LineHeight="102" LetterSpacing="-4"
                               Foreground="White" />
                    <TextBlock Text="podcasts, paced like radio." FontFamily="{StaticResource SulphurPoint}"
                               FontWeight="Bold" FontSize="30" Foreground="#D9FFFFFF"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Stations curate your feeds into a single queue. Connect this app to your own Ohrbob server and listen without the noise."
                               FontSize="14" LineHeight="21" Foreground="#99FFFFFF"
                               TextWrapping="Wrap" MaxWidth="520" />
                </StackPanel>

                <Border x:Name="ConnectPanel" Grid.Column="1" Margin="0,20,0,34"
                        Background="#CC080D18" BorderBrush="#26FFFFFF" BorderThickness="1"
                        VerticalAlignment="Center" MaxWidth="470">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Height="7" Background="{StaticResource MetroAccentBrush}" />
                        <StackPanel Grid.Row="1" Spacing="16" Margin="30,26,30,30">
                            <StackPanel Spacing="4">
                                <TextBlock Text="connect" Classes="metroHeadline" FontSize="46"
                                           Foreground="White" />
                                <TextBlock Text="one link and your stations are here."
                                           FontSize="12" Foreground="#99FFFFFF" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Error is shown in both modes. -->
                            <TextBlock x:Name="ConnectionErrorTextBlock"
                                       Text="{Binding ConnectionErrorMessage}"
                                       Foreground="#FFB4AB" FontSize="12" TextWrapping="Wrap"
                                       IsVisible="{Binding ConnectionErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                            <!-- Simple mode: one obvious action. -->
                            <StackPanel Spacing="12" IsVisible="{Binding !IsAdvancedMode}">
                                <TextBlock Text="Connect with ohrbob.org" Classes="onboardingFieldLabel" />
                                <Button x:Name="HostedConnectButton"
                                        Command="{Binding OpenHostedConnectPageCommand}"
                                        Content="Connect with ohrbob.org"
                                        Classes="metroPrimary"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center" />
                                <Button x:Name="ScanQrButton"
                                        Command="{Binding ScanQrCodeCommand}"
                                        Content="Scan QR code"
                                        Classes="metroViolet"
                                        IsVisible="{Binding CanScanQrCode}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center" />
                                <Button x:Name="ShowAdvancedButton"
                                        Command="{Binding ToggleAdvancedModeCommand}"
                                        Content="I have a server link"
                                        Classes="metroGhost"
                                        Foreground="#B3FFFFFF"
                                        HorizontalAlignment="Left"
                                        Padding="0,8"
                                        FontSize="12" />
                            </StackPanel>

                            <!-- Advanced mode: deep link, server and token. -->
                            <StackPanel Spacing="14" IsVisible="{Binding IsAdvancedMode}">
                                <TextBlock Text="Paste the connection link from your Ohrbob web interface."
                                           FontSize="12" Foreground="#99FFFFFF" TextWrapping="Wrap" />

                                <Button x:Name="ScanQrAdvancedButton"
                                        Command="{Binding ScanQrCodeCommand}"
                                        Content="Scan QR code"
                                        Classes="metroViolet"
                                        IsVisible="{Binding CanScanQrCode}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center" />

                                <StackPanel Spacing="5">
                                    <TextBlock Text="CONNECTION LINK" Classes="onboardingFieldLabel" />
                                    <TextBox Text="{Binding DeepLinkInput}"
                                             PlaceholderText="ohrbob://connect?server=...&amp;token=..."
                                             Classes="onboardingField" />
                                </StackPanel>

                                <TextBlock Text="OR ENTER MANUALLY" FontSize="9" FontWeight="Bold"
                                           LetterSpacing="2" Foreground="#80FFFFFF" Margin="0,2" />

                                <StackPanel Spacing="5">
                                    <TextBlock Text="SERVER URL" Classes="onboardingFieldLabel" />
                                    <TextBox x:Name="ServerUrlTextBox"
                                             Text="{Binding ServerUrlInput}"
                                             PlaceholderText="https://player.ohrbob.org"
                                             Classes="onboardingField" />
                                </StackPanel>

                                <StackPanel Spacing="5">
                                    <TextBlock Text="STREAM TOKEN" Classes="onboardingFieldLabel" />
                                    <TextBox x:Name="TokenTextBox"
                                             Text="{Binding TokenInput}"
                                             PlaceholderText="Your profile stream token"
                                             Classes="onboardingField" />
                                </StackPanel>

                                <Button Command="{Binding ConnectCommand}" Content="Connect application"
                                        Classes="metroPrimary"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Margin="0,4,0,0" />

                                <Button x:Name="HideAdvancedButton"
                                        Command="{Binding ToggleAdvancedModeCommand}"
                                        Content="Back to simple setup"
                                        Classes="metroGhost"
                                        Foreground="#B3FFFFFF"
                                        HorizontalAlignment="Left"
                                        Padding="0,6"
                                        FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="46,0,46,24">
                <TextBlock Grid.Column="0" Text="self-hosted · host pace · private by default"
                           FontSize="10" FontWeight="SemiBold" LetterSpacing="1"
                           Foreground="#66FFFFFF" />
                <TextBlock Grid.Column="1" Text="METRO" FontSize="9" FontWeight="Bold"
                           LetterSpacing="3" Foreground="#66FFFFFF" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
