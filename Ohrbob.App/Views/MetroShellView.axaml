<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ohrbob.App.ViewModels"
             xmlns:views="using:Ohrbob.App.Views"
             xmlns:services="using:Ohrbob.App.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
             x:Class="Ohrbob.App.Views.MetroShellView"
             x:DataType="vm:MainViewModel"
             Container.Name="shell"
             Container.Sizing="Width"
             Background="{DynamicResource MetroCanvasBrush}"
             Foreground="{DynamicResource MetroInkBrush}">

    <UserControl.Styles>
        <!-- Station grid -> player zoom. Both layers stay alive so the zoom can
             cross-fade in place. -->
        <Style Selector="Border.screen">
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.34" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.5" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border#StationsLayer">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Border#StationsLayer.closed">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="scale(1.14)" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Border#PlayerLayer">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="scale(0.84)" />
            <Setter Property="RenderTransformOrigin" Value="50%,55%" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Border#PlayerLayer.open">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>

        <Style Selector="Button.stationTile">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,18,18" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.stationTile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.stationTile:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Border.modalCard">
            <Setter Property="Background" Value="{DynamicResource MetroCanvasBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MetroHairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 18 60 0 #66000000" />
        </Style>

        <ContainerQuery Name="shell" Query="max-width: 760">
            <Style Selector="TextBlock#StationsTitle">
                <Setter Property="FontSize" Value="58" />
                <Setter Property="LineHeight" Value="54" />
            </Style>
            <Style Selector="Grid#StationsHeader">
                <Setter Property="Margin" Value="24,22,18,10" />
            </Style>
            <Style Selector="ItemsControl#StationGrid">
                <Setter Property="Margin" Value="18,4,0,18" />
            </Style>
            <Style Selector="Button#BackToStations">
                <Setter Property="Padding" Value="4,6" />
            </Style>
        </ContainerQuery>
    </UserControl.Styles>

    <Grid Background="{DynamicResource MetroCanvasBrush}">
        <!-- Screen 2: the station grid / Metro start screen. -->
        <Border x:Name="StationsLayer" Classes="screen" Classes.closed="{Binding IsNowPlayingOpen}">
            <Grid RowDefinitions="Auto,*">
                <Grid x:Name="StationsHeader" Grid.Row="0" ColumnDefinitions="*,Auto" Margin="44,32,32,16">
                    <StackPanel Grid.Column="0" Spacing="0">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <views:OhrbobLogoText FontSize="18" />
                            <TextBlock Text="player" FontSize="11" FontWeight="Bold" LetterSpacing="2"
                                       Foreground="{DynamicResource MetroMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="StationsTitle" Text="stations" Classes="metroDisplay" Margin="0,10,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                        <Button Classes="metroGhost" Command="{Binding OpenProfileSettingsCommand}"
                                ToolTip.Tip="Open profile settings">
                            <StackPanel Spacing="0" HorizontalAlignment="Right">
                                <TextBlock Text="listening as" Classes="metroLabel" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding ProfileName, FallbackValue='profile'}"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource MetroInkBrush}"
                                           HorizontalAlignment="Right" />
                            </StackPanel>
                        </Button>
                        <Button Classes="metroTool" Command="{Binding RefreshAllCommand}" ToolTip.Tip="Refresh">
                            <PathIcon Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                                      Width="17" Height="17" Foreground="{DynamicResource MetroInkBrush}" />
                        </Button>
                        <Button Classes="metroGhost" Content="disconnect" FontSize="11"
                                Command="{Binding DisconnectCommand}" Opacity="0.7" />
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Panel>
                        <ItemsControl x:Name="StationGrid" ItemsSource="{Binding Stations}" Margin="44,4,26,26">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="272" ItemHeight="184" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="stationTile"
                                            Width="272" Height="184"
                                            Tag="{Binding}"
                                            Click="OnStationTileClick"
                                            PointerPressed="OnStationTilePointerPressed"
                                            PointerReleased="OnStationTilePointerReleased"
                                            PointerCaptureLost="OnStationTilePointerCaptureLost"
                                            ToolTip.Tip="Tap to listen · long-press for settings">
                                        <Border Background="{StaticResource MetroNavyBrush}" ClipToBounds="True" Width="272" Height="184"
                                                BorderBrush="{DynamicResource MetroCanvasBrush}" BorderThickness="0,0,16,16">
                                            <Panel ClipToBounds="True">
                                                <ItemsControl ItemsSource="{Binding Feeds}" Opacity="0.72">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="2" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Image services:ImageLoader.Source="{Binding ImageUrl}"
                                                                   services:ImageLoader.MaxWidth="320"
                                                                   Stretch="UniformToFill"
                                                                   IsVisible="{Binding ImageUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Border>
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                            <GradientStop Offset="0" Color="#33000A14" />
                                                            <GradientStop Offset="0.55" Color="#99000A14" />
                                                            <GradientStop Offset="1" Color="#E6000A14" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>

                                                <Grid RowDefinitions="*,Auto" Margin="18,16,18,18">
                                                    <StackPanel Grid.Row="1" Spacing="8">
                                                        <Border Width="46" Height="5"
                                                                Background="{StaticResource MetroAccentBrush}"
                                                                HorizontalAlignment="Left" />
                                                        <TextBlock Text="{Binding Station.Name, FallbackValue='Untitled station'}"
                                                                   FontFamily="{StaticResource SulphurPoint}"
                                                                   FontSize="27" FontWeight="Bold" LineHeight="27"
                                                                   Foreground="White" TextWrapping="Wrap"
                                                                   MaxHeight="58" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Panel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                    IsVisible="{Binding !HasStations}" Margin="0,80,0,0">
                            <TextBlock Text="no stations yet" Classes="metroTitle" HorizontalAlignment="Center" />
                            <TextBlock Text="Create a station in the Ohrbob web app, then refresh."
                                       Foreground="{DynamicResource MetroMutedBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Panel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Screens 3 + 4: now playing and the station playlist. Wide layouts
             show both columns; narrow layouts slide the panorama by a peek. -->
        <Border x:Name="PlayerLayer" Classes="screen" Classes.open="{Binding IsNowPlayingOpen}">
            <Grid RowDefinitions="Auto,*" Background="{DynamicResource MetroCanvasBrush}">
                <Border Grid.Row="0" Background="#0A0E18" BorderBrush="#26FFFFFF" BorderThickness="0,0,0,1"
                        Padding="18,8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button x:Name="BackToStations" Grid.Column="0" Classes="metroGhost"
                                Command="{Binding ShowStationsCommand}" Foreground="White">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="←" FontSize="17" VerticalAlignment="Center" />
                                <TextBlock Text="stations" FontSize="12" FontWeight="Bold"
                                           LetterSpacing="1" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <TextBlock Grid.Column="1" Text="{Binding SelectedStation.Station.Name, FallbackValue='ohrbob'}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="12" FontWeight="Bold" LetterSpacing="2"
                                   Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="420" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button Classes="metroGhost" Command="{Binding OpenSettingsCommand}"
                                    Foreground="White" ToolTip.Tip="Station settings">
                                <PathIcon Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12C19.5,11.66 19.47,11.34 19.43,11.02L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.65 15.48,5.32 14.87,5.07L14.49,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.51,2.42L9.13,5.07C8.52,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11.02C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.52,18.68 9.13,18.93L9.51,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.49,21.58L14.87,18.93C15.48,18.68 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.98Z"
                                          Width="16" Height="16" Foreground="White" />
                            </Button>
                            <Button Classes="metroGhost" Command="{Binding OpenProfileSettingsCommand}"
                                    Foreground="White" ToolTip.Tip="Profile settings">
                                <TextBlock Text="{Binding ProfileName, FallbackValue='profile'}" FontSize="11"
                                           FontWeight="SemiBold" MaxWidth="120" TextTrimming="CharacterEllipsis" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Panel x:Name="PanoramaViewport" Grid.Row="1" ClipToBounds="True">
                    <Canvas x:Name="PanoramaCanvas" Background="Transparent"
                            HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Border x:Name="NowPlayingPage" Canvas.Left="0" Width="900">
                            <views:NowPlayingView />
                        </Border>
                        <Border x:Name="PlaylistPage" Canvas.Left="900" Width="440">
                            <views:PlaylistView />
                        </Border>
                    </Canvas>
                </Panel>
            </Grid>
        </Border>

        <!-- Station settings modal, opened by long-pressing a tile. -->
        <Panel x:Name="SettingsOverlay" IsVisible="{Binding IsSettingsOpen}">
            <Border Background="{DynamicResource MetroScrimBrush}" PointerPressed="OnSettingsScrimPointerPressed" />
            <Border Classes="modalCard" Width="520" MaxWidth="560" Margin="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Height="6" Background="{StaticResource MetroAccentBrush}" />
                    <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="28,22,28,24">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="station settings" Classes="metroHeadline" FontSize="34" />
                                <TextBlock Text="{Binding SettingsStation.Station.Name, FallbackValue='No station selected'}"
                                           FontSize="12" FontWeight="Bold" LetterSpacing="2"
                                           Foreground="{StaticResource MetroAccentBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="metroTool" Command="{Binding CloseSettingsCommand}"
                                    VerticalAlignment="Top" ToolTip.Tip="Close">
                                <TextBlock Text="×" FontSize="26" FontWeight="Light" />
                            </Button>
                        </Grid>

                        <StackPanel Grid.Row="1" Spacing="16" Margin="0,22,0,0">
                            <TextBlock Text="buffer ahead" Classes="metroLabel" />
                            <ComboBox x:Name="BufferOptionsBox" Classes="metroCombo"
                                      ItemsSource="{Binding BufferOptions}"
                                      SelectedItem="{Binding SelectedBufferOption, Mode=TwoWay}"
                                      IsEnabled="{Binding IsBufferSelectionEnabled}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Whole upcoming episodes of this station are downloaded. More buffer uses more storage."
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MetroMutedBrush}" />
                            <Border Background="{StaticResource MetroYellowBrush}" Padding="10"
                                    IsVisible="{Binding DownloadBlockedReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding DownloadBlockedReason}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource OhrbobDarkBlue}" />
                            </Border>
                            <Grid ColumnDefinitions="*,Auto">
                                <Button Classes="metroGhost" Command="{Binding OpenStationSettingsCommand}"
                                        Content="open in browser" FontSize="11" HorizontalAlignment="Left" />
                                <Button Grid.Column="1" Classes="metroGhost" Command="{Binding CloseSettingsCommand}"
                                        Content="done" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Panel>

        <!-- Long-press episode actions. Completion is kept with the local queue. -->
        <Panel x:Name="EpisodeActionsOverlay" IsVisible="{Binding IsEpisodeActionsOpen}">
            <Border Background="{DynamicResource MetroScrimBrush}" PointerPressed="OnEpisodeActionsScrimPointerPressed" />
            <Border Classes="modalCard" Width="500" MaxWidth="540" Margin="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Height="6" Background="{StaticResource MetroVioletBrush}" />
                    <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="28,22,28,24">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="episode" Classes="metroHeadline" FontSize="34" />
                                <TextBlock Text="{Binding SelectedEpisodeForActions.Title}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MetroMutedBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="metroTool" Command="{Binding CloseEpisodeActionsCommand}"
                                    VerticalAlignment="Top" ToolTip.Tip="Close">
                                <TextBlock Text="×" FontSize="26" FontWeight="Light" />
                            </Button>
                        </Grid>

                        <StackPanel Grid.Row="1" Spacing="16" Margin="0,22,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="✓" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource MetroVioletBrush}"
                                           IsVisible="{Binding SelectedEpisodeForActions.IsCompleted}" />
                                <TextBlock Text="{Binding SelectedEpisodeForActions.CompletionLabel}"
                                           FontSize="12" FontWeight="Bold" LetterSpacing="1"
                                           Foreground="{StaticResource MetroVioletBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Completed episodes stay in this station's playlist on this device."
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MetroMutedBrush}" />
                            <Button Classes="metroViolet"
                                    Content="{Binding SelectedEpisodeActionLabel}"
                                    Command="{Binding ToggleEpisodeCompletionCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" />
                            <Button Classes="metroGhost" Content="close"
                                    Command="{Binding CloseEpisodeActionsCommand}"
                                    HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Panel>

        <!-- Refresh toast -->
        <Border IsVisible="{Binding IsRefreshIndicatorVisible}"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,12,0,0" Padding="14,7"
                Background="{StaticResource MetroAccentBrush}" IsHitTestVisible="False">
            <TextBlock Text="UPDATED" Foreground="White" FontSize="10" FontWeight="Bold" LetterSpacing="2" />
        </Border>
    </Grid>
</UserControl>
