<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ohrbob.App.ViewModels"
             xmlns:services="using:Ohrbob.App.Services"
             xmlns:views="using:Ohrbob.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Ohrbob.App.Views.PlayerView"
             x:DataType="vm:MainViewModel">

    <UserControl.Resources>
        <SolidColorBrush x:Key="OhrbobOrange" Color="{StaticResource OhrbobStrongOrange}" />
    </UserControl.Resources>

    <UserControl.KeyBindings>
        <KeyBinding Gesture="F5" Command="{Binding RefreshAllCommand}" />
    </UserControl.KeyBindings>

    <UserControl.Styles>
        <!-- Desktop / Wide (default) styles -->
        <Style Selector="SplitView#MainSplitView">
            <Setter Property="DisplayMode" Value="Inline" />
            <Setter Property="IsPaneOpen" Value="True" />
        </Style>
        <Style Selector="Button#MenuButton">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Mobile / Narrow styles bound to ViewModel -->
        <Style Selector="SplitView#MainSplitView.portrait">
            <Setter Property="DisplayMode" Value="Overlay" />
            <Setter Property="IsPaneOpen" Value="{Binding IsSidebarOpen}" />
        </Style>
        <Style Selector="SplitView#MainSplitView.portrait Button#MenuButton">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- Right-side overlays slide in/out instead of appearing instantly. -->
        <Style Selector="Panel.overlay">
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Panel.overlay.open">
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Panel.overlay Border.scrim">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Panel.overlay.open Border.scrim">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Panel.overlay Border.overlayPanel">
            <Setter Property="RenderTransform" Value="translateX(360px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Panel.overlay.open Border.overlayPanel">
            <Setter Property="RenderTransform" Value="none" />
        </Style>

        <Style Selector="TextBlock.stateLabel">
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
        </Style>
        <Style Selector="TextBlock.stateLabel.downloaded">
            <Setter Property="Foreground" Value="#198754" />
        </Style>
        <Style Selector="TextBlock.stateLabel.notDownloaded">
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
        </Style>
        <Style Selector="TextBlock.stateLabel.downloading">
            <Setter Property="Foreground" Value="{StaticResource OhrbobStrongOrange}" />
        </Style>
        <Style Selector="TextBlock.stateLabel.queued">
            <Setter Property="Foreground" Value="{StaticResource ThemeSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.stateLabel.failed">
            <Setter Property="Foreground" Value="{StaticResource ThemeDangerBrush}" />
        </Style>
    </UserControl.Styles>

        <SplitView Name="MainSplitView" Classes.portrait="{Binding IsPortrait}"
                   OpenPaneLength="260">
            
            <SplitView.Pane>
            <!-- Left Sidebar wrapped in Border for styling -->
            <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto, *, Auto">
                    <!-- App Header -->
                    <StackPanel Grid.Row="0" Margin="24,24,24,15" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Image Source="../Assets/ohrbob-logo.png" Width="24" Height="24" />
                            <views:OhrbobLogoText FontSize="24" Margin="0,-2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Stations List Section -->
                    <Grid Grid.Row="1" RowDefinitions="Auto, *">
                        <ListBox Grid.Row="1" ItemsSource="{Binding Stations}" SelectedItem="{Binding SelectedStation}"
                                 Background="Transparent" BorderThickness="0" Margin="12,0,12,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="stationCard" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="8" Padding="8" Margin="4,4" BoxShadow="0 4 12 0 #10000000">
                                        <Grid ColumnDefinitions="Auto, *">
                                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="6" Background="{DynamicResource AppSurfaceBrush}" Margin="0,0,12,0" ClipToBounds="True">
                                                <Panel>
                                                    <PathIcon Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8Z" 
                                                              Width="24" Height="24" Foreground="{StaticResource OhrbobOrange}" Opacity="0.5" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    <ItemsControl ItemsSource="{Binding Feeds}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Image services:ImageLoader.Source="{Binding ImageUrl}" Stretch="UniformToFill" IsVisible="{Binding ImageUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Panel>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Station.Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource AppForegroundBrush}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem Border.stationCard">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                </Style>
                                <Style Selector="ListBoxItem:selected Border.stationCard">
                                    <Setter Property="BorderBrush" Value="{StaticResource ThemePrimaryBrush}" />
                                    <Setter Property="BorderThickness" Value="4" />
                                </Style>
                            </ListBox.Styles>
                        </ListBox>
                    </Grid>

                    <!-- Sidebar Footer (Profile / Disconnect) -->
                    <Border Grid.Row="2" Background="{DynamicResource AppSurfaceBrush}" Padding="16" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="*, Auto">
                            <Button Grid.Column="0" Command="{Binding OpenProfileSettingsCommand}" Background="Transparent" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Listening as" FontSize="11" Foreground="{DynamicResource AppMutedTextBrush}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ProfileName}" FontSize="13" Foreground="{DynamicResource AppForegroundBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Command="{Binding DisconnectCommand}" Content="Disconnect"
                                    Background="{DynamicResource AppBorderBrush}" Foreground="{DynamicResource AppForegroundBrush}" FontSize="11" CornerRadius="12" Padding="12,6" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            </SplitView.Pane>

            <SplitView.Content>
            <!-- Right Detail Player View wrapped in Border for padding & styling -->
            <Border Background="{StaticResource AppBackgroundBrush}">
                <Grid RowDefinitions="Auto, *">
                    
                    <Button Name="MenuButton" Grid.Row="0" Command="{Binding ToggleSidebarCommand}" 
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="Transparent" Margin="8,8,0,8">
                        <PathIcon Data="M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z" Foreground="{DynamicResource AppForegroundBrush}" Width="24" Height="24" />
                    </Button>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,12,8">
                        <Button Name="SettingsButton" Command="{Binding OpenSettingsCommand}" Width="30" Height="30" CornerRadius="15" Padding="0"
                                Background="Transparent" BorderThickness="0" Opacity="0.7" ToolTip.Tip="Settings">
                            <PathIcon Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12C19.5,11.66 19.47,11.34 19.43,11.02L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.65 15.48,5.32 14.87,5.07L14.49,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.51,2.42L9.13,5.07C8.52,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11.02C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.52,18.68 9.13,18.93L9.51,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.49,21.58L14.87,18.93C15.48,18.68 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.98Z"
                                      Width="18" Height="18" Foreground="{DynamicResource AppForegroundBrush}" />
                        </Button>
                        <Button Name="UpNextButton" Command="{Binding ToggleUpNextCommand}" Content="Up next"
                                Background="{DynamicResource AppSurfaceBrush}" Foreground="{DynamicResource AppForegroundBrush}"
                                FontSize="11" FontWeight="SemiBold" CornerRadius="12" Padding="12,6" />
                    </StackPanel>
                    
                    <!-- Error Message Banner -->
                    <Border Grid.Row="0" Background="{StaticResource ThemeDangerBrush}" Margin="48,8,120,8" Padding="12,8" CornerRadius="6"
                            VerticalAlignment="Top" HorizontalAlignment="Stretch"
                            IsVisible="{Binding ConnectionErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding ConnectionErrorMessage}" Foreground="White" FontSize="12" TextWrapping="Wrap" />
                    </Border>

                    <!-- Center Info Pane (Episode details, Cover Art, Description).
                         The widget floats over it so the backdrop can be blurred. -->
                    <Panel x:Name="PlayerOverlayHost" Grid.Row="1">
                    <ScrollViewer Name="EpisodeScroll" Margin="0,0,0,0" Padding="32,32,32,120" VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="680" Spacing="16">
                        <!-- Station Title -->
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <TextBlock x:Name="StationTitle"
                                       Text="{Binding SelectedStation.Station.Name, FallbackValue='No Active Station'}"
                                       FontSize="12" FontWeight="Bold" Foreground="{StaticResource OhrbobOrange}" LetterSpacing="1" />
                            <Border Background="{StaticResource OhrbobOrange}" CornerRadius="4" Padding="6,2" IsVisible="{Binding IsBuffering}">
                                <TextBlock Text="Buffering..." FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppForegroundBrush}" />
                            </Border>
                        </StackPanel>

                        <!-- Episode Cover Art -->
                        <Border x:Name="CoverArt" Width="280" Height="280" HorizontalAlignment="Center"
                                Background="{DynamicResource AppSurfaceBrush}" CornerRadius="16" BoxShadow="0 8 30 0 #20000000">
                            <Panel>
                                <PathIcon Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,10A2,2 0 0,0 10,12A2,2 0 0,0 12,14A2,2 0 0,0 14,12A2,2 0 0,0 12,10Z"
                                          Width="64" Height="64" Foreground="{StaticResource OhrbobOrange}" Opacity="0.5" />
                                <Image services:ImageLoader.Source="{Binding CurrentEpisodeCoverUrl}" Stretch="UniformToFill" Margin="0" IsVisible="{Binding CurrentEpisodeCoverUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                <!-- Buffering Blur Overlay -->
                                <Border Background="{DynamicResource AppOverlayBrush}" CornerRadius="16" IsVisible="{Binding IsBuffering}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                                        <ProgressBar IsIndeterminate="True" Width="100" Height="4" Foreground="{StaticResource OhrbobOrange}" Background="Transparent" />
                                        <TextBlock Text="Buffering..." FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Panel>
                        </Border>

                        <!-- Episode Title -->
                        <TextBlock x:Name="EpisodeTitle" Text="{Binding CurrentEpisodeTitle}"
                                   FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppForegroundBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />

                        <!-- Episode Description -->
                        <views:LinkTextBlock x:Name="EpisodeDescription" SourceText="{Binding CurrentEpisodeDescription}"
                                             LinkCommand="{Binding OpenLinkCommand}"
                                             FontSize="14" Foreground="{DynamicResource AppForegroundBrush}"
                                             TextWrapping="Wrap" LineHeight="20" />

                        <!-- Up Next Feature -->
                        <Border Background="{DynamicResource AppSurfaceBrush}" CornerRadius="8" Padding="12,10"
                                IsVisible="{Binding NextEpisodeTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="NEXT:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OhrbobOrange}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding NextEpisodeTitle}" FontSize="12" Foreground="{DynamicResource AppForegroundBrush}" FontWeight="SemiBold" MaxWidth="300" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Controller Deck, floating over the scroll content -->
                    <views:AudioWidget VerticalAlignment="Bottom"
                                       BackdropSource="{Binding #EpisodeScroll}" />

                    <!-- Up next panel: swiped in from the right, or opened by its button -->
                    <Panel x:Name="UpNextOverlay" Classes="overlay" Classes.open="{Binding IsUpNextOpen}">
                        <Border Classes="scrim" Background="#80000000" PointerPressed="CloseUpNextOnPointer" />
                        <Border x:Name="UpNextPanel" Classes="overlayPanel" MaxWidth="360" HorizontalAlignment="Right"
                                Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,0,0,0">
                            <Grid RowDefinitions="Auto,Auto,*">
                                <StackPanel Grid.Row="0" Margin="16">
                                    <TextBlock Text="Up next" Classes="h2" />
                                    <TextBlock Text="{Binding SelectedStation.Station.Name}" FontSize="12"
                                               Foreground="{DynamicResource AppMutedTextBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="16,0,16,8" Spacing="8">
                                    <Border Padding="10" CornerRadius="6"
                                            Background="{StaticResource ThemeWarningBrush}"
                                            IsVisible="{Binding DownloadStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="{Binding DownloadStatusMessage}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{StaticResource OhrbobDarkBlue}" />
                                    </Border>
                                    <TextBlock Text="Loading…" FontSize="12"
                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                               IsVisible="{Binding IsPlaylistLoading}" />
                                    <TextBlock Text="Up next is not available on this server." FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                               IsVisible="{Binding IsPlaylistUnavailable}" />
                                    <TextBlock Text="No upcoming episodes" FontSize="12"
                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                               IsVisible="{Binding IsPlaylistEmpty}" />
                                </StackPanel>
                                <ListBox x:Name="UpNextListBox" Grid.Row="2" ItemsSource="{Binding PlaylistItems}" Background="Transparent"
                                         BorderThickness="0" Margin="8">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="8">
                                                <Border Width="44" Height="44" CornerRadius="6" ClipToBounds="True"
                                                        Background="{DynamicResource AppBackgroundBrush}">
                                                    <Image services:ImageLoader.Source="{Binding CoverUrl}" Stretch="UniformToFill"
                                                           IsVisible="{Binding CoverUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AppForegroundBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Artist}" FontSize="11"
                                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding PublishedAtLabel}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource AppMutedTextBrush}" />
                                                </StackPanel>
                                                <Panel Grid.Column="2" VerticalAlignment="Center">
                                                    <Panel IsVisible="{Binding !IsCurrent}">
                                                        <TextBlock Text="{Binding StateLabel}" FontSize="10" FontWeight="Bold"
                                                                   Classes="stateLabel"
                                                                   Classes.downloaded="{Binding IsDownloaded}"
                                                                   Classes.notDownloaded="{Binding IsNotDownloaded}"
                                                                   Classes.downloading="{Binding IsDownloading}"
                                                                   Classes.queued="{Binding IsQueued}"
                                                                   Classes.failed="{Binding IsFailed}"
                                                                   IsVisible="{Binding ShowDownloadStateLabel}" />
                                                    </Panel>
                                                    <TextBlock Text="Playing" FontSize="10" FontWeight="Bold"
                                                               IsVisible="{Binding IsCurrent}"
                                                               Foreground="{StaticResource ThemeSecondaryBrush}" />
                                                </Panel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Panel>

                    <!-- Per-station settings, full-height from the right like Up next -->
                    <Panel x:Name="SettingsOverlay" Classes="overlay" Classes.open="{Binding IsSettingsOpen}">
                        <Border Classes="scrim" Background="#80000000" PointerPressed="CloseSettingsOnPointer" />
                        <Border x:Name="SettingsPanel" Classes="overlayPanel" MaxWidth="360" HorizontalAlignment="Right"
                                Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,0,0,0">
                            <Grid RowDefinitions="Auto,*">
                                <StackPanel Grid.Row="0" Margin="16">
                                    <TextBlock Text="Settings" Classes="h2" />
                                    <TextBlock Text="{Binding SelectedStation.Station.Name, FallbackValue='No active station'}"
                                               FontSize="12"
                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="16" Spacing="16">
                                    <TextBlock Text="Buffer ahead" FontSize="13" FontWeight="SemiBold" />
                                    <ComboBox x:Name="BufferOptionsBox"
                                              ItemsSource="{Binding BufferOptions}"
                                              SelectedItem="{Binding SelectedBufferOption, Mode=TwoWay}"
                                              IsEnabled="{Binding IsBufferSelectionEnabled}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="Whole upcoming episodes of this station are downloaded. More buffer uses more storage."
                                               FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource AppMutedTextBrush}" />
                                    <Border Background="{StaticResource ThemeWarningBrush}" CornerRadius="6" Padding="10"
                                            IsVisible="{Binding DownloadBlockedReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="{Binding DownloadBlockedReason}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{StaticResource OhrbobDarkBlue}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Panel>

                    <!-- Refresh result toast -->
                    <Border IsVisible="{Binding IsRefreshIndicatorVisible}"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,12,0,0" Padding="14,6" CornerRadius="14"
                            Background="#198754" IsHitTestVisible="False">
                        <TextBlock Text="Updated" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    </Panel>

                </Grid>
            </Border>
            </SplitView.Content>
        </SplitView>

</UserControl>