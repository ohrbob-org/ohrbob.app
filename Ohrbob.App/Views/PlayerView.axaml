<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ohrbob.App.ViewModels"
             xmlns:services="using:Ohrbob.App.Services"
             xmlns:views="using:Ohrbob.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Ohrbob.App.Views.PlayerView"
             x:DataType="vm:MainViewModel">

    <UserControl.Resources>
        <SolidColorBrush x:Key="OhrbobOrange" Color="{StaticResource OhrbobStrongOrange}" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Desktop / Wide (default) styles -->
        <Style Selector="SplitView#MainSplitView">
            <Setter Property="DisplayMode" Value="Inline" />
            <Setter Property="IsPaneOpen" Value="True" />
        </Style>
        <Style Selector="Button#MenuButton">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Mobile / Narrow styles bound to ViewModel -->
        <Style Selector="SplitView#MainSplitView.portrait">
            <Setter Property="DisplayMode" Value="Overlay" />
            <Setter Property="IsPaneOpen" Value="{Binding IsSidebarOpen}" />
        </Style>
        <Style Selector="SplitView#MainSplitView.portrait Button#MenuButton">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </UserControl.Styles>

        <SplitView Name="MainSplitView" Classes.portrait="{Binding IsPortrait}"
                   OpenPaneLength="260">
            
            <SplitView.Pane>
            <!-- Left Sidebar wrapped in Border for styling -->
            <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto, *, Auto">
                    <!-- App Header -->
                    <StackPanel Grid.Row="0" Margin="24,24,24,15" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Image Source="../Assets/ohrbob-logo.png" Width="24" Height="24" />
                            <views:OhrbobLogoText FontSize="24" Margin="0,-2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Stations List Section -->
                    <Grid Grid.Row="1" RowDefinitions="Auto, *">
                        <ListBox Grid.Row="1" ItemsSource="{Binding Stations}" SelectedItem="{Binding SelectedStation}"
                                 Background="Transparent" BorderThickness="0" Margin="12,0,12,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="stationCard" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="8" Padding="8" Margin="4,4" BoxShadow="0 4 12 0 #10000000">
                                        <Grid ColumnDefinitions="Auto, *">
                                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="6" Background="{DynamicResource AppSurfaceBrush}" Margin="0,0,12,0" ClipToBounds="True">
                                                <Panel>
                                                    <PathIcon Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8Z" 
                                                              Width="24" Height="24" Foreground="{StaticResource OhrbobOrange}" Opacity="0.5" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    <ItemsControl ItemsSource="{Binding Feeds}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Image services:ImageLoader.Source="{Binding ImageUrl}" Stretch="UniformToFill" IsVisible="{Binding ImageUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Panel>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Station.Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource AppForegroundBrush}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem Border.stationCard">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                </Style>
                                <Style Selector="ListBoxItem:selected Border.stationCard">
                                    <Setter Property="BorderBrush" Value="{StaticResource ThemePrimaryBrush}" />
                                    <Setter Property="BorderThickness" Value="4" />
                                </Style>
                            </ListBox.Styles>
                        </ListBox>
                    </Grid>

                    <!-- Sidebar Footer (Settings / Disconnect) -->
                    <Border Grid.Row="2" Background="{DynamicResource AppSurfaceBrush}" Padding="16" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Connected Stream" FontSize="11" Foreground="{DynamicResource AppMutedTextBrush}" FontWeight="SemiBold" />
                                <TextBlock Text="Active Profile" FontSize="13" Foreground="{DynamicResource AppForegroundBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding DisconnectCommand}" Content="Disconnect"
                                    Background="{DynamicResource AppBorderBrush}" Foreground="{DynamicResource AppForegroundBrush}" FontSize="11" CornerRadius="12" Padding="12,6" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            </SplitView.Pane>

            <SplitView.Content>
            <!-- Right Detail Player View wrapped in Border for padding & styling -->
            <Border Background="{StaticResource AppBackgroundBrush}">
                <Grid RowDefinitions="Auto, *, Auto">
                    
                    <Button Name="MenuButton" Grid.Row="0" Command="{Binding ToggleSidebarCommand}" 
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="Transparent" Margin="8,8,0,8">
                        <PathIcon Data="M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z" Foreground="{DynamicResource AppForegroundBrush}" Width="24" Height="24" />
                    </Button>

                    <!-- Center Info Pane (Episode details, Cover Art, Description) -->
                    <ScrollViewer Grid.Row="1" Margin="0,0,0,24" Padding="32" VerticalScrollBarVisibility="Auto">
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- Album Art Block -->
                        <Grid Width="320" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="280" Height="280" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="16" BoxShadow="0 8 30 0 #20000000">
                                <!-- Placeholder or Image -->
                                <Panel>
                                    <PathIcon Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,10A2,2 0 0,0 10,12A2,2 0 0,0 12,14A2,2 0 0,0 14,12A2,2 0 0,0 12,10Z" 
                                              Width="64" Height="64" Foreground="{StaticResource OhrbobOrange}" Opacity="0.5" />
                                    <Image services:ImageLoader.Source="{Binding CurrentEpisodeCoverUrl}" Stretch="UniformToFill" Margin="0" IsVisible="{Binding CurrentEpisodeCoverUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    
                                    <!-- Buffering Blur Overlay -->
                                    <Border Background="{DynamicResource AppOverlayBrush}" CornerRadius="16" IsVisible="{Binding IsBuffering}">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                                            <ProgressBar IsIndeterminate="True" Width="100" Height="4" Foreground="{StaticResource OhrbobOrange}" Background="Transparent" />
                                            <TextBlock Text="Buffering..." FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Panel>
                            </Border>
                        </Grid>

                        <!-- Text Details Box -->
                        <Grid Width="360" RowDefinitions="Auto, *, Auto" Margin="24,12,0,12">
                            <!-- Station & Episode Title -->
                            <StackPanel Grid.Row="0" Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding SelectedStation.Station.Name, FallbackValue='No Active Station'}" 
                                               FontSize="12" FontWeight="Bold" Foreground="{StaticResource OhrbobOrange}" LetterSpacing="1" />
                                    <Border Background="{StaticResource OhrbobOrange}" CornerRadius="4" Padding="6,2" IsVisible="{Binding IsBuffering}">
                                        <TextBlock Text="Buffering..." FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppForegroundBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding CurrentEpisodeTitle}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppForegroundBrush}" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Episode Description Scrollable Panel -->
                            <TextBlock Grid.Row="1" Margin="0,16,0,16" Text="{Binding CurrentEpisodeDescription}" FontSize="14" Foreground="{DynamicResource AppForegroundBrush}" TextWrapping="Wrap" LineHeight="20" />

                            <!-- Up Next Feature -->
                            <Border Grid.Row="2" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="8" Padding="12,10" IsVisible="{Binding NextEpisodeTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="NEXT:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OhrbobOrange}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding NextEpisodeTitle}" FontSize="12" Foreground="{DynamicResource AppForegroundBrush}" FontWeight="SemiBold" MaxWidth="300" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </WrapPanel>
                    </ScrollViewer>

                    <!-- Bottom Controller Deck (Audio Widget) -->
                    <views:AudioWidget Grid.Row="2" />
                    
                </Grid>
            </Border>
            </SplitView.Content>
        </SplitView>

</UserControl>