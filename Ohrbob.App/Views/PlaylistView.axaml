<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ohrbob.App.ViewModels"
             xmlns:models="using:Ohrbob.App.Models"
             xmlns:views="using:Ohrbob.App.Views"
             xmlns:services="using:Ohrbob.App.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="430" d:DesignHeight="700"
             x:Class="Ohrbob.App.Views.PlaylistView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource MetroCanvasBrush}"
             ClipToBounds="True">

    <UserControl.Styles>
        <Style Selector="Border.episodeRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0,14" />
            <Setter Property="BorderBrush" Value="{DynamicResource MetroHairlineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Border.episodeRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource MetroTileBrush}" />
        </Style>
        <Style Selector="Border.episodeRow.completed TextBlock.episodeTitle">
            <Setter Property="TextDecorations" Value="Strikethrough" />
            <Setter Property="Foreground" Value="{DynamicResource MetroMutedBrush}" />
        </Style>
        <Style Selector="Border.episodeRow.completed">
            <Setter Property="Opacity" Value="0.68" />
        </Style>
        <Style Selector="ListBox.playlistBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox.playlistBox ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="ListBox.playlistBox ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.playlistBox ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.playlistBox ListBoxItem:selected Border.episodeRow">
            <Setter Property="Background" Value="{DynamicResource MetroTileBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*" Background="{DynamicResource MetroCanvasBrush}">
        <Border Grid.Row="0" BorderBrush="{DynamicResource MetroHairlineBrush}" BorderThickness="1,0,0,0"
                Padding="28,30,24,18">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock x:Name="PlaylistTitle" Text="playlist" Classes="metroHeadline"
                               FontSize="46" LineHeight="56" />
                    <TextBlock Text="{Binding SelectedStation.Station.Name, FallbackValue='station playlist'}"
                               FontSize="12" FontWeight="Bold" LetterSpacing="2"
                               Foreground="{StaticResource MetroAccentBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="long-press an episode to mark it completed"
                               FontSize="11" Foreground="{DynamicResource MetroMutedBrush}"
                               TextWrapping="Wrap" MaxWidth="360" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
                    <Button x:Name="PlaylistSettingsButton" Classes="metroTool"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip.Tip="Station settings">
                        <PathIcon Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12C19.5,11.66 19.47,11.34 19.43,11.02L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.65 15.48,5.32 14.87,5.07L14.49,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.51,2.42L9.13,5.07C8.52,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11.02C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.52,18.68 9.13,18.93L9.51,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.49,21.58L14.87,18.93C15.48,18.68 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.98Z"
                                  Width="17" Height="17" Foreground="{DynamicResource MetroInkBrush}" />
                    </Button>
                    <Button Classes="metroTool"
                            Command="{Binding HidePlaylistCommand}"
                            IsVisible="{Binding $parent[views:MetroShellView].IsNarrow}"
                            ToolTip.Tip="Back to now playing">
                        <TextBlock Text="×" FontSize="26" FontWeight="Light" Foreground="{DynamicResource MetroInkBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="28,0,24,12" Spacing="8">
            <Border Padding="10" Background="{StaticResource MetroYellowBrush}"
                    IsVisible="{Binding DownloadStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding DownloadStatusMessage}" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource OhrbobDarkBlue}" />
            </Border>
            <TextBlock Text="Loading…" FontSize="12" Foreground="{DynamicResource MetroMutedBrush}"
                       IsVisible="{Binding IsPlaylistLoading}" />
            <TextBlock Text="Up next is not available on this server." FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource MetroMutedBrush}"
                       IsVisible="{Binding IsPlaylistUnavailable}" />
            <TextBlock Text="No episodes in this station" FontSize="12"
                       Foreground="{DynamicResource MetroMutedBrush}"
                       IsVisible="{Binding IsPlaylistEmpty}" />
        </StackPanel>

        <ListBox x:Name="PlaylistList" Grid.Row="2" Classes="playlistBox"
                 ItemsSource="{Binding PlaylistItems}" Margin="18,0,12,12"
                 SelectionMode="Single">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:PlaylistItem">
                    <Border Classes="episodeRow"
                            Classes.completed="{Binding IsCompleted}"
                            PointerPressed="OnEpisodePointerPressed"
                            PointerReleased="OnEpisodePointerReleased"
                            PointerCaptureLost="OnEpisodePointerCaptureLost"
                            ToolTip.Tip="Long-press for episode actions">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0" Width="4" Background="{StaticResource MetroAccentBrush}"
                                    IsVisible="{Binding IsCurrent}" />
                            <Border Grid.Column="1" Width="58" Height="58" ClipToBounds="True"
                                    Background="{DynamicResource MetroTileBrush}"
                                    IsVisible="{Binding CoverUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <Image Classes="episodeThumb"
                                       services:ImageLoader.Source="{Binding CoverUrl}"
                                       services:ImageLoader.MaxWidth="120"
                                       Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Classes="episodeTitle" Text="{Binding Title}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MetroInkBrush}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                <TextBlock Text="{Binding Artist}" FontSize="11"
                                           Foreground="{DynamicResource MetroMutedBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding PublishedAtLabel}" FontSize="10"
                                               Foreground="{DynamicResource MetroMutedBrush}" />
                                    <TextBlock Text="{Binding CompletionLabel}" FontSize="10" FontWeight="Bold"
                                               LetterSpacing="1"
                                               Foreground="{StaticResource MetroAccentBrush}"
                                               IsVisible="{Binding IsCompleted}" />
                                    <TextBlock Text="{Binding StateLabel}" FontSize="10"
                                               Foreground="{DynamicResource MetroMutedBrush}"
                                               IsVisible="{Binding ShowDownloadStateLabel}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="4"
                                        HorizontalAlignment="Right">
                                <TextBlock Text="NOW" FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                           Foreground="{StaticResource MetroAccentBrush}"
                                           IsVisible="{Binding IsCurrent}" />
                                <TextBlock Text="✓" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource MetroVioletBrush}"
                                           IsVisible="{Binding IsCompleted}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
