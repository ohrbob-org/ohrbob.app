<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SoundFlow" Version="1.4.1" />
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\Images\ohrbob-logo.png" />
    <EmbeddedResource Include="Resources\Images\ohrbob-logo.png" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\Images\ohrbob-logo.svg" />
    <Resource Include="Resources\Images\ohrbob-logo.svg" />
  </ItemGroup>

  <!-- Stamp the version into the assembly at build time so the UI never has to
       hard-code it. An explicit OhrbobVersion (set by the packaging scripts)
       wins; otherwise the newest git tag is used, then the platform build
       version, then the SDK default. -->
  <Target Name="GenerateOhrbobVersion"
          BeforeTargets="BeforeCompile"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_OhrbobVersionFile>$(IntermediateOutputPath)OhrbobVersion.g.cs</_OhrbobVersionFile>
      <_OhrbobGitVersionFile>$(IntermediateOutputPath)OhrbobGitVersion.txt</_OhrbobGitVersionFile>
      <_OhrbobVersion>$(OhrbobVersion)</_OhrbobVersion>
    </PropertyGroup>

    <Delete Files="$(_OhrbobGitVersionFile)"
            Condition="'$(_OhrbobVersion)' == ''" />

    <Exec Command="git describe --tags --abbrev=0 &gt; &quot;$(_OhrbobGitVersionFile)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          IgnoreExitCode="true"
          Condition="'$(_OhrbobVersion)' == ''"
          StandardOutputImportance="low"
          StandardErrorImportance="low" />

    <ReadLinesFromFile File="$(_OhrbobGitVersionFile)"
                       Condition="'$(_OhrbobVersion)' == '' and Exists('$(_OhrbobGitVersionFile)')">
      <Output TaskParameter="Lines" ItemName="_OhrbobGitVersionLines" />
    </ReadLinesFromFile>

    <PropertyGroup>
      <_OhrbobGitVersion>@(_OhrbobGitVersionLines)</_OhrbobGitVersion>
    </PropertyGroup>

    <PropertyGroup>
      <_OhrbobVersion Condition="'$(_OhrbobVersion)' == ''">$([System.Text.RegularExpressions.Regex]::Replace('$(_OhrbobGitVersion)', '^v', ''))</_OhrbobVersion>
      <_OhrbobVersion Condition="'$(_OhrbobVersion)' == ''">$(ApplicationDisplayVersion)</_OhrbobVersion>
      <_OhrbobVersion Condition="'$(_OhrbobVersion)' == ''">$(VersionPrefix)</_OhrbobVersion>
    </PropertyGroup>

    <ItemGroup>
      <_OhrbobVersionAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>OhrbobVersion</_Parameter1>
        <_Parameter2>$(_OhrbobVersion)</_Parameter2>
      </_OhrbobVersionAttribute>
    </ItemGroup>

    <WriteCodeFragment AssemblyAttributes="@(_OhrbobVersionAttribute)"
                       Language="C#"
                       OutputFile="$(_OhrbobVersionFile)">
      <Output TaskParameter="OutputFile" ItemName="Compile" />
      <Output TaskParameter="OutputFile" ItemName="FileWrites" />
    </WriteCodeFragment>
  </Target>
</Project>
