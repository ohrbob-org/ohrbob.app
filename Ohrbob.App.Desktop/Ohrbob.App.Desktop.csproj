<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--If you are willing to use platform-specific APIs, use conditional compilation.
    See https://docs.avaloniaui.net/docs/guides/platforms/platform-specific-code/dotnet for more details.-->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationIcon>..\Ohrbob.App\Assets\ohrbob-logo.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ohrbob.App\Ohrbob.App.csproj" />
  </ItemGroup>

  <!-- On Linux, desktop shells (like GNOME) strictly rely on .desktop files to show dock/taskbar icons. 
       This target automatically installs the .desktop file and icon to the developer's local environment 
       during debug builds, so Rider / dotnet run shows the correct application logo. -->
  <Target Name="InstallDevDesktopFile" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Linux')) And '$(Configuration)' == 'Debug'">
    <Exec Command="mkdir -p ~/.local/share/applications ~/.local/share/icons/hicolor/scalable/apps" />
    <Exec Command="cp $(MSBuildProjectDirectory)/../org.ohrbob.ohrbob.desktop ~/.local/share/applications/" />
    <Exec Command="cp $(MSBuildProjectDirectory)/../art/ohrbob-logo.svg ~/.local/share/icons/hicolor/scalable/apps/org.ohrbob.ohrbob.svg" />
    <Exec Command="update-desktop-database ~/.local/share/applications || true" />
  </Target>
</Project>
